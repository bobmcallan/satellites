# Canonical version definitions for V5 binaries.
# Per-binary so satellites (CLI) and satellites-server can rev
# independently. The release workflow currently tags v<satellites.version>
# as the canonical operator-facing version. True divergent release
# cadence (independent per-binary tags) is a future enhancement; today
# both binaries normally rev together.

satellites.version: 0.0.3
satellites.build: 2026-05-21-01-08-06

satellites-server.version: 0.0.3
satellites-server.build: 2026-05-21-01-08-06
