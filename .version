# Canonical version definitions for V5 binaries.
# Per-binary so satellites (CLI) and satellites-server can rev
# independently. Version info is baked into the binary via -ldflags at
# build time; .version is a build-time source file, NEVER deployed in
# release artifacts or docker images.

satellites.version: 0.0.448
satellites.build: 2026-06-25-13-23-48

satellites-server.version: 0.0.421
satellites-server.build: 2026-06-25-13-44-31
